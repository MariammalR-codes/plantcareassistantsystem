<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAF1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/backButton"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#183D22"
                android:textSize="38sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="AI Analysis Result"
                android:textColor="#164D27"
                android:textSize="21sp"
                android:textStyle="bold" />

            <View
                android:layout_width="45dp"
                android:layout_height="45dp" />

        </LinearLayout>


        <!-- RESULT IMAGE -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="22dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/resultPlantImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E8F5E9"
                android:contentDescription="Analysed plant photo"
                android:scaleType="centerCrop" />

        </androidx.cardview.widget.CardView>


        <!-- RESULT CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌿  Detection Result"
                    android:textColor="#164D27"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- PLANT -->

                <TextView
                    android:id="@+id/detectedPlantText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Plant: Tomato"
                    android:textColor="#183D22"
                    android:textSize="17sp"
                    android:textStyle="bold" />


                <!-- DISEASE -->

                <TextView
                    android:id="@+id/detectedDiseaseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Disease: Early Blight"
                    android:textColor="#183D22"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- SYMPTOMS -->

                <TextView
                    android:id="@+id/symptomsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Symptoms: Brown spots and yellowing on leaves"
                    android:textColor="#59675C"
                    android:textSize="15sp"
                    android:lineSpacingExtra="3dp" />


                <!-- SEVERITY -->

                <TextView
                    android:id="@+id/severityText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Severity: Moderate"
                    android:textColor="#E65100"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- VIEW CARE TIPS -->

        <Button
            android:id="@+id/viewCareTipsButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:text="🌱  View Care Tips"
            android:textAllCaps="false"
            android:textSize="16sp" />


        <!-- SET WATER REMINDER -->

        <Button
            android:id="@+id/setWaterReminderButton"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="25dp"
            android:text="💧  Set Water Reminder"
            android:textAllCaps="false"
            android:textSize="16sp" />

    </LinearLayout>

</ScrollView>