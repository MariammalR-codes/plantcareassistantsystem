<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification Permission for Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plantcareassistantsystem">

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Screen -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home Screen -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Plant Information -->
        <activity
            android:name=".PlantInformationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI Disease Detection -->
        <activity
            android:name=".AIDiseaseDetectionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Plant Care Information -->
        <activity
            android:name=".PlantCareInformationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Water Reminder -->
        <activity
            android:name=".WaterReminderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Water Reminder Notification Receiver -->
        <receiver
            android:name=".WaterReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".AiAnalysisResultActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>